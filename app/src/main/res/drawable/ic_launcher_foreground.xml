<?xml version="1.0" encoding="utf-8"?>
<!--
     Couple Moments mark: two figures leaning in toward each other - the same rotated-pivot
     technique the previous campfire mark used for its crossed logs, applied here to tilt two
     whole figures inward - with their clasped hands meeting low between them and a heart nestled
     where their heads nearly touch.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glow halo -->
    <path
        android:fillColor="#FFDDB5"
        android:fillAlpha="0.45"
        android:pathData="M54,58m-28,0a28,28 0,1 1,56 0a28,28 0,1 1,-56 0" />

    <!-- Left figure, leaning in -->
    <group
        android:pivotX="54"
        android:pivotY="82"
        android:rotation="-13">
        <path
            android:fillColor="#BF6900"
            android:pathData="M32,82 L32,68 A11,11 0 0 1 54,62 A11,11 0 0 1 54,82 Z" />
        <path
            android:fillColor="#BF6900"
            android:pathData="M40,38m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />
    </group>

    <!-- Right figure, leaning in -->
    <group
        android:pivotX="54"
        android:pivotY="82"
        android:rotation="13">
        <path
            android:fillColor="#D8471F"
            android:pathData="M76,82 L76,68 A11,11 0 0 0 54,62 A11,11 0 0 0 54,82 Z" />
        <path
            android:fillColor="#D8471F"
            android:pathData="M68,38m-8,0a8,8 0,1 1,16 0a8,8 0,1 1,-16 0" />
    </group>

    <!-- Clasped hands, meeting where the two figures lean together -->
    <group
        android:pivotX="50.5"
        android:pivotY="78"
        android:rotation="-18">
        <path
            android:fillColor="#BF6900"
            android:pathData="M45,78 A5.5,3.8 0 1 1 56,78 A5.5,3.8 0 1 1 45,78 Z" />
    </group>
    <group
        android:pivotX="57.5"
        android:pivotY="78"
        android:rotation="18">
        <path
            android:fillColor="#D8471F"
            android:pathData="M52,78 A5.5,3.8 0 1 1 63,78 A5.5,3.8 0 1 1 52,78 Z" />
    </group>

    <!-- Heart, between the two heads -->
    <path
        android:fillColor="#FF6F91"
        android:fillAlpha="0.95"
        android:pathData="M54,42 C52,39 47,39 47,43.4 C47,47.8 51,51 54,54.2 C57,51 61,47.8 61,43.4 C61,39 56,39 54,42 Z" />
</vector>
