<?xml version="1.0" encoding="utf-8"?>
<!--
     Family Moments mark: three rounded-square "cards" (matching the app's own swipeable question
     cards) rotated 45deg and overlapped - two "parent" cards on top of a "child" card - so their
     combined silhouette reads as a heart. Content is kept within the 66dp safe-zone circle (33dp
     radius from the 54,54 center) so it isn't clipped by adaptive-icon masking/parallax on any
     launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- "Child" card - bottom point of the heart -->
    <group
        android:pivotX="54"
        android:pivotY="52.5"
        android:rotation="45">
        <path
            android:fillColor="#FFB95A"
            android:pathData="M41.5,37 L66.5,37 A3,3 0 0 1 69.5,40 L69.5,65 A3,3 0 0 1 66.5,68 L41.5,68 A3,3 0 0 1 38.5,65 L38.5,40 A3,3 0 0 1 41.5,37 Z" />
    </group>

    <!-- Left "parent" card -->
    <group
        android:pivotX="38.5"
        android:pivotY="46"
        android:rotation="45">
        <path
            android:fillColor="#BF6900"
            android:pathData="M31.5,35 L45.5,35 A4,4 0 0 1 49.5,39 L49.5,53 A4,4 0 0 1 45.5,57 L31.5,57 A4,4 0 0 1 27.5,53 L27.5,39 A4,4 0 0 1 31.5,35 Z" />
    </group>

    <!-- Right "parent" card -->
    <group
        android:pivotX="69.5"
        android:pivotY="46"
        android:rotation="45">
        <path
            android:fillColor="#E8734A"
            android:pathData="M62.5,35 L76.5,35 A4,4 0 0 1 80.5,39 L80.5,53 A4,4 0 0 1 76.5,57 L62.5,57 A4,4 0 0 1 58.5,53 L58.5,39 A4,4 0 0 1 62.5,35 Z" />
    </group>

    <!-- Sparkle accent -->
    <path
        android:fillColor="#FFD27A"
        android:pathData="M78,26 L79.6,30.4 L78,34.8 L76.4,30.4 Z" />
    <path
        android:fillColor="#FFD27A"
        android:pathData="M74,30.4 L78,32 L82,30.4 L78,28.8 Z" />
</vector>
